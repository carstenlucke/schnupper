# OpenAI API-Key für die Bildgenerierung
# Kopiere diese Datei nach .env und trage deinen Key ein:
#   cp .env.example .env
OPENAI_API_KEY=sk-dein-key-hier

# Optional: Modell für alle fünf Agenten zugleich.
#
# Leer lassen, dann gilt der `model:`-Eintrag in agents/<name>.md. Gesetzt
# schlägt diese Zeile alle Agentendateien — gedacht für den Fall, dass ein
# Anbieter mitten in der Vorlesung bremst: Zeile ändern, Server neu starten.
# Was zur Auswahl steht, zeigt `pi --list-models`.
#   openai-codex/gpt-5.6-luna   (ChatGPT-Abo, Voreinstellung der Agenten)
SHIP_IT_MODEL=

# Optional: Bildmodell für Logo und Instagram-Bild.
#
# Leer lassen, dann gilt gpt-image-2.5-sunburst. Das Modell muss den
# Endpunkt /v1/images/edits beherrschen – das Instagram-Bild bekommt das Logo
# als Referenzbild mit.
SHIP_IT_IMAGE_MODEL=
